# ─────────────────────────────────────────────────────────────
# FRONTEND (safe to expose — these ship to the browser)
# Copy this file to `.env` (never commit `.env`).
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
# The public "anon" / "publishable" key from Supabase → Project Settings → API.
VITE_SUPABASE_ANON_KEY=

# Weather provider: "open-meteo" (free, no key) or "none" to disable weather.
VITE_WEATHER_PROVIDER=open-meteo

# Web Push public key (from `npx web-push generate-vapid-keys`). Leave empty to hide browser notifications.
VITE_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS — DO NOT put these in VITE_ variables
# Set them with the Supabase CLI, e.g.:
#   supabase secrets set AI_API_KEY=... AI_MODEL=... AI_API_URL=...
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
#  injected automatically into Edge Functions by Supabase.)
# ─────────────────────────────────────────────────────────────
# AI_API_KEY=            # required for the AI stylist
# AI_MODEL=              # required, e.g. a chat model your provider offers
# AI_API_URL=            # optional, OpenAI-compatible /chat/completions URL
#                        # default: https://api.openai.com/v1/chat/completions
# ALLOWED_ORIGIN=        # optional, CORS origin (default "*"; set to your site in production)

# Notifications + Resend (see README → Notifications):
# VAPID_PUBLIC_KEY=      # same value as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=     # keep secret
# VAPID_SUBJECT=         # mailto:you@yourdomain.com
# RESEND_API_KEY=        # re_...
# RESEND_FROM=           # "Sage <hello@yourdomain.com>" (verified domain)
# SITE_URL=              # https://your-site.example
# CRON_SECRET=           # long random string; the scheduler sends it as x-cron-secret
